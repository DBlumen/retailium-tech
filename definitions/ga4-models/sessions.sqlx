config {
  type: "incremental",
  description: "GA4 sessions table",
  schema: "ga4_export_fixer",
  bigquery: {
    partitionBy: "event_date",
    clusterBy: ['session_id', 'data_is_final'],
   labels: {
      reporting_ready: true
    }
  },
  // include the same ga4_export_fixer tag that the event table has
  tags: ['ga4_export_fixer']
}

js {
  const { setPreOperations, helpers } = require('ga4-export-fixer');
  const ga4Constants = require('includes/ga4_constants');

  // define the configuration for the pre-operations and date filters
  const config = {
    self: self(),
    incremental: incremental(),
    test: false,
    testConfig: {
        dateRangeStart: 'current_date()-1',
        dateRangeEnd: 'current_date()',
    },
    // same options available for preOperations as in the event table
    // https://github.com/tanelytics/ga4-export-fixer#preOperations
    preOperations: {
        // dateRangeStartFullRefresh: 'date(2000, 1, 1)',
        // dateRangeEnd: 'current_date()',
        // incrementalStartOverride: undefined,
        // incrementalEndOverride: undefined,
        // numberOfDaysToProcess: undefined
    },
  };

  // setPreOperations returns '' on a full refresh. Resolve it here so the
  // pre_operations block below stays completely empty in that case - leaving a
  // bare comment there makes Dataform emit a lone ';', which BigQuery rejects.
  const preOperationsSQL = setPreOperations(config);

  /*
  The Google Ads account-level tracking template tags every click with utm parameters.
  Each one lands in two places: the session-scoped last-click attribution struct, and the
  traffic source collected on the event itself. Prefer the attributed value and fall back
  to what was collected, the same order the gclid below resolves in.

  GA4 writes the literal string '(not set)' into manual_campaign for sessions that carried
  no utm parameters at all, which would win a plain coalesce ahead of the fallback.
  */
  const utmField = (lastClickField, collectedField) => `coalesce(
    max(nullif(session_traffic_source_last_click.manual_campaign.${lastClickField}, '(not set)')),
    max(session_first_traffic_source.${collectedField}),
    max(collected_traffic_source.${collectedField})
  )`;
}

select
  event_date,
  session_id,
  user_pseudo_id,
  user_id,
  -- the user_id field with a fallback to user_pseudo_id if null
  merged_user_id,
  any_value(session_traffic_source_last_click.cross_channel_campaign) as session_traffic_source,
  any_value(landing_page) as landing_page,
  -- the session's gclid, for joining to the Google Ads clicks table
  -- max() over strings skips nulls, so this picks whichever source has a value
  coalesce(
    max(session_first_traffic_source.gclid),
    max(collected_traffic_source.gclid),
    max(${helpers.unnestEventParam('gclid', 'string')})
  ) as gclid,
  -- the tracking template's utm parameters. utm_content carries the ad group id and
  -- utm_term the keyword, so the two are named for what the template puts in them
  ${utmField('source', 'manual_source')} as utm_source,
  ${utmField('medium', 'manual_medium')} as utm_medium,
  ${utmField('campaign_name', 'manual_campaign_name')} as utm_campaign_name,
  ${utmField('campaign_id', 'manual_campaign_id')} as utm_campaign_id,
  ${utmField('content', 'manual_content')} as utm_ad_group_id,
  ${utmField('term', 'manual_term')} as utm_keyword,
  -- session number: 1 means a new user's first session
  max(${helpers.unnestEventParam('ga_session_number', 'int')}) as session_number,
  -- GA4 stores session_engaged as the string '1', not an integer
  max(${helpers.unnestEventParam('session_engaged', 'string')}) as session_engaged,
  any_value(device.category) as device_category,
  any_value(device.web_info.browser) as browser,
  any_value(device.operating_system) as operating_system,
  any_value(geo.country) as country,
  any_value(geo.region) as region,
  any_value(geo.city) as city,
  countif(event_name = 'page_view') as page_views,
  -- conversion events are configured in includes/ga4_constants.js
  countif(event_name in unnest(${ga4Constants.sqlArray(ga4Constants.CONVERSION_EVENTS)})) as conversion_events,
  countif(event_name = 'first_visit') as first_visit_events,
  countif(event_name = 'click') as click_events,
  countif(event_name = 'form_start') as form_start_events,
  countif(event_name = 'video_start') as video_start_events,
  countif(event_name = 'video_end') as video_end_events,
  count(*) as session_events,
  sum(
    ifnull(${helpers.unnestEventParam('engagement_time_msec', 'int')}, 0)
  ) as session_engagement_time_msec,
  current_datetime() as row_inserted_timestamp,
  -- include the row's data_is_final status in the aggregation
  min(data_is_final) as data_is_final
from
  -- reference the enhanced events table created earlier
  ${ref('ga4_events_enhanced_543168832')}
where
  -- use the date range filter helper
  -- reads the start and end dates from the same configuration that the pre-operations use
  ${helpers.incrementalDateFilter(config)}
group by 
  event_date,
  session_id,
  user_pseudo_id,
  user_id,
  merged_user_id

pre_operations {
  ${preOperationsSQL}
}