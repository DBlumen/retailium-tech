config {
  type: "table",
  description: "Google Ads ad performance report. One row per date, campaign, ad group and ad, with impressions, clicks, conversions and cost. Sourced from the full-coverage AdStats view, so it reconciles to account totals. The Google Ads transfer exposes no view carrying ad and keyword together, so ad-level performance lives here rather than in gads_basic_stats.",
  schema: "marts_google_ads",
  bigquery: {
    partitionBy: "date",
    clusterBy: ['campaign_name', 'ad_group_name'],
  },
  tags: ['google_ads', 'google_ads_marts']
}

js {
  const { helpers } = require('ga4-export-fixer');

  // Same Google Ads Data Transfer account as definitions/google_ads_clicks.js
  const source = {
    dataset: "retailiumtech.google_ads_110_359_2301", // "project.dataset" of the transfer
    customerId: "1103592301",                       // the account CID
  };

  // Google Ads keeps revising recent days as clicks / conversions settle; a date is
  // "final" once older than this many days. Matches the package table configs.
  const dayThreshold = 7;
}

-- Dimension views hold one snapshot per day; the latest one is the current state.
with campaigns as (
  select
    campaign_id,
    any_value(campaign_name) as campaign_name
  from
    ${helpers.googleAdsSourceTable(source, 'Campaign')}
  where
    ${helpers.googleAdsLatestSnapshotFilter}
  group by
    campaign_id
),

ad_groups as (
  select
    ad_group_id,
    any_value(ad_group_name) as ad_group_name
  from
    ${helpers.googleAdsSourceTable(source, 'AdGroup')}
  where
    ${helpers.googleAdsLatestSnapshotFilter}
  group by
    ad_group_id
),

ads as (
  select
    ad_group_id,
    ad_group_ad_ad_id as ad_id,
    any_value(ad_group_ad_ad_type) as ad_type,
    any_value(ad_group_ad_status) as ad_status,
    -- Responsive search ads carry no ad name, so label them with their first three
    -- headlines; the id alone is not readable in a report.
    any_value(coalesce(
      nullif(ad_group_ad_ad_name, ''),
      nullif(
        array_to_string(
          array(
            select json_value(headline, '$.text')
            from unnest(json_extract_array(ad_group_ad_ad_responsive_search_ad_headlines)) as headline
              with offset as headline_index
            order by headline_index
            limit 3
          ),
          ' | '
        ),
        ''
      ),
      nullif(
        array_to_string(
          [
            ad_group_ad_ad_expanded_text_ad_headline_part1,
            ad_group_ad_ad_expanded_text_ad_headline_part2,
            ad_group_ad_ad_expanded_text_ad_headline_part3
          ],
          ' | '
        ),
        ''
      ),
      cast(ad_group_ad_ad_id as string)
    )) as ad_name
  from
    ${helpers.googleAdsSourceTable(source, 'Ad')}
  where
    ${helpers.googleAdsLatestSnapshotFilter}
  group by
    ad_group_id,
    ad_id
),

-- Account currency, the unit for the cost column. One row.
customer as (
  select
    any_value(customer_currency_code) as currency
  from
    ${helpers.googleAdsSourceTable(source, 'Customer')}
  where
    ${helpers.googleAdsLatestSnapshotFilter}
)

select
  stats.segments_date as date,

  -- entities, from the latest dimension snapshots
  stats.campaign_id,
  campaigns.campaign_name,
  stats.ad_group_id,
  ad_groups.ad_group_name,
  stats.ad_group_ad_ad_id as ad_id,
  -- ads removed from the account since the click keep their metrics but lose their label
  coalesce(ads.ad_name, cast(stats.ad_group_ad_ad_id as string)) as ad_name,
  coalesce(ads.ad_type, '(not set)') as ad_type,
  coalesce(ads.ad_status, '(not set)') as ad_status,

  customer.currency,

  -- metrics, summed across device / ad network to the grain above
  sum(stats.metrics_impressions) as impressions,
  sum(stats.metrics_clicks) as clicks,
  safe_divide(sum(stats.metrics_clicks), sum(stats.metrics_impressions)) as ctr,
  -- fractional; Google Ads attributes conversions fractionally
  sum(stats.metrics_conversions) as conversions,
  safe_divide(sum(stats.metrics_conversions), sum(stats.metrics_clicks)) as conversion_rate,
  -- cost is stored in millionths of the account currency
  sum(stats.metrics_cost_micros) / 1000000 as cost,

  ${helpers.googleAdsDataIsFinal('stats.segments_date', dayThreshold)} as data_is_final,
  current_datetime() as row_inserted_timestamp
from
  ${helpers.googleAdsSourceTable(source, 'AdStats')} stats
left join
  campaigns
  on stats.campaign_id = campaigns.campaign_id
left join
  ad_groups
  on stats.ad_group_id = ad_groups.ad_group_id
left join
  ads
  on stats.ad_group_id = ads.ad_group_id
  and stats.ad_group_ad_ad_id = ads.ad_id
cross join
  customer
group by
  date,
  campaign_id,
  campaign_name,
  ad_group_id,
  ad_group_name,
  ad_id,
  ad_name,
  ad_type,
  ad_status,
  currency
