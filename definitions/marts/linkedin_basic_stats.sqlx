config {
  type: "table",
  description: "Basic LinkedIn Ads performance report at ad (creative) grain. One row per date, campaign, ad group and ad, with impressions, clicks, cost, conversion and engagement metrics. Sourced from the Airbyte LinkedIn connector's ad_creative_analytics table and enriched with the latest Account / CampaignGroup / Campaign / Creative dimension rows. Column names follow the Google Ads convention so this mart lines up with marts_google_ads.gads_basic_stats: LinkedIn's campaign group is reported as campaign, its campaign as ad group, and its creative as ad. Scoped to the Retailium ad account only - the source dataset also carries another advertiser's campaigns. Creative-level stats exist only for campaigns that ran creatives, so cost here totals below true account spend; use linkedin_campaign_stats to reconcile against the LinkedIn UI.",
  schema: "marts_linkedin_ads",
  bigquery: {
    partitionBy: "date",
    clusterBy: ['campaign_name', 'ad_group_name'],
  },
  tags: ['linkedin_ads', 'linkedin_ads_marts']
}

js {
  const li = require('includes/linkedin_constants');
}

-- LinkedIn's hierarchy is Account > Campaign Group > Campaign > Creative. It is
-- reported here one level shifted, so the columns match the Google Ads mart:
--   campaign group -> campaign_id / campaign_name
--   campaign       -> ad_group_id / ad_group_name
--   creative       -> ad_id / ad_name

-- Account currency, the unit for the cost column. One row.
with account as (
  select
    cast(id as string) as account_id,
    name as account_name,
    currency
  from
    ${ref('accounts')}
  where
    cast(id as string) = '${li.RETAILIUM_ACCOUNT_ID}'
  ${li.latestRow(['id'])}
),

campaign_groups as (
  select
    cast(id as string) as campaign_group_id,
    name as campaign_group_name
  from
    ${ref('campaign_groups')}
  where
    account = '${li.RETAILIUM_ACCOUNT_URN}'
  ${li.latestRow(['id'])}
),

campaigns as (
  select
    cast(id as string) as campaign_id,
    name as campaign_name,
    ${li.urnId('campaignGroup')} as campaign_group_id,
    format as ad_format,
    objectiveType as objective,
    costType as cost_type,
    status as campaign_status
  from
    ${ref('campaigns')}
  where
    account = '${li.RETAILIUM_ACCOUNT_URN}'
  ${li.latestRow(['id'])}
),

creatives as (
  select
    ${li.urnId('id')} as creative_id,
    ${li.urnId('campaign')} as campaign_id,
    -- Boosted-post creatives are named with their own numeric id, which reads as
    -- nothing in a report, so a name that merely repeats the id falls through to the
    -- follower-ad headline and then to the boosted post's id.
    coalesce(
      nullif(nullif(name, ''), ${li.urnId('id')}),
      json_value(content, '$.follow.headline.custom'),
      'Boosted post ' || ${li.urnId("json_value(content, '$.reference')")},
      ${li.urnId('id')}
    ) as creative_name,
    intendedStatus as creative_status
  from
    ${ref('creatives')}
  where
    account = '${li.RETAILIUM_ACCOUNT_URN}'
  ${li.latestRow(['id'])}
)

select
  stats.start_date as date,

  -- entities, from the latest dimension rows
  safe_cast(account.account_id as int64) as account_id,
  account.account_name,
  safe_cast(campaigns.campaign_group_id as int64) as campaign_id,
  -- Several campaign groups the campaigns point at were never synced by the
  -- connector, so fall back to the id rather than losing the row's identity.
  coalesce(
    campaign_groups.campaign_group_name,
    'Campaign group ' || campaigns.campaign_group_id,
    '(not set)'
  ) as campaign_name,
  safe_cast(campaigns.campaign_id as int64) as ad_group_id,
  coalesce(campaigns.campaign_name, '(not set)') as ad_group_name,
  safe_cast(creatives.creative_id as int64) as ad_id,
  coalesce(creatives.creative_name, '(not set)') as ad_name,

  coalesce(campaigns.ad_format, '(not set)') as ad_format,
  coalesce(campaigns.objective, '(not set)') as objective,
  coalesce(campaigns.cost_type, '(not set)') as cost_type,
  account.currency,

  -- metrics. The source columns are NUMERIC; counts are cast to int64 and money to
  -- float64 so the shared columns match gads_basic_stats type for type.
  -- Nulls are left to sum() to skip rather than coalesced to zero: the most recent
  -- day arrives with impressions but no clicks or cost, and data_is_final flags it.
  cast(sum(stats.impressions) as int64) as impressions,
  cast(sum(stats.clicks) as int64) as clicks,
  cast(safe_divide(sum(stats.clicks), sum(stats.impressions)) as float64) as ctr,
  cast(sum(stats.costInLocalCurrency) as float64) as cost,
  cast(safe_divide(sum(stats.costInLocalCurrency), sum(stats.clicks)) as float64) as cpc,
  cast(safe_divide(sum(stats.costInLocalCurrency), sum(stats.impressions)) * 1000 as float64) as cpm,

  -- conversions. LinkedIn has no single metric equivalent to Google's conversions
  -- column; externalWebsiteConversions is the closest and is used as the headline.
  cast(sum(stats.externalWebsiteConversions) as float64) as conversions,
  cast(safe_divide(sum(stats.externalWebsiteConversions), sum(stats.clicks)) as float64) as conversion_rate,
  cast(sum(stats.externalWebsitePostClickConversions) as float64) as post_click_conversions,
  cast(sum(stats.externalWebsitePostViewConversions) as float64) as post_view_conversions,
  cast(sum(stats.oneClickLeads) as int64) as one_click_leads,
  cast(sum(stats.conversionValueInLocalCurrency) as float64) as conversion_value,

  -- engagement. Most Retailium campaigns are boosted-post engagement campaigns, so
  -- these carry more signal than the conversion columns.
  cast(sum(stats.likes) as int64) as likes,
  cast(sum(stats.comments) as int64) as comments,
  cast(sum(stats.shares) as int64) as shares,
  cast(sum(stats.follows) as int64) as follows,
  cast(sum(stats.companyPageClicks) as int64) as company_page_clicks,
  cast(sum(stats.landingPageClicks) as int64) as landing_page_clicks,
  cast(sum(stats.totalEngagements) as int64) as total_engagements,
  cast(safe_divide(sum(stats.totalEngagements), sum(stats.impressions)) as float64) as engagement_rate,

  ${li.dataIsFinal('stats.start_date')} as data_is_final,
  current_datetime() as row_inserted_timestamp
from
  ${ref('ad_creative_analytics')} stats
-- Inner joins: the analytics tables carry no account column, so these dimension
-- joins are what confine the mart to the Retailium account.
inner join
  creatives
  on creatives.creative_id = stats.sponsoredCreative
inner join
  campaigns
  on campaigns.campaign_id = creatives.campaign_id
left join
  campaign_groups
  on campaign_groups.campaign_group_id = campaigns.campaign_group_id
cross join
  account
group by
  date,
  account_id,
  account_name,
  campaign_id,
  campaign_name,
  ad_group_id,
  ad_group_name,
  ad_id,
  ad_name,
  ad_format,
  objective,
  cost_type,
  currency
