config {
  type: "table",
  description: "Basic Google Ads search performance report. One row per date, campaign, ad group, keyword and search term, with impressions, clicks, conversions and cost. Metrics come from the full-coverage KeywordStats view, so the report reconciles to account totals. Google only publishes search terms that clear its query-volume privacy threshold; the metrics it withholds are carried on a '(not disclosed)' search_term row for the same keyword and day rather than being dropped.",
  schema: "marts_google_ads",
  bigquery: {
    partitionBy: "date",
    clusterBy: ['campaign_name', 'ad_group_name'],
  },
  tags: ['google_ads', 'google_ads_marts']
}

js {
  const { helpers } = require('ga4-export-fixer');

  // Same Google Ads Data Transfer account as definitions/google_ads_clicks.js
  const source = {
    dataset: "retailiumtech.google_ads_110_359_2301", // "project.dataset" of the transfer
    customerId: "1103592301",                       // the account CID
  };

  // Google Ads keeps revising recent days as clicks / conversions settle; a date is
  // "final" once older than this many days. Matches the package table configs.
  const dayThreshold = 7;
}

-- The spine: keyword-grain metrics, which carry every click the account served.
with keyword_stats as (
  select
    segments_date as date,
    campaign_id,
    ad_group_id,
    ad_group_criterion_criterion_id as keyword_id,
    sum(metrics_impressions) as impressions,
    sum(metrics_clicks) as clicks,
    sum(metrics_conversions) as conversions,
    sum(metrics_cost_micros) as cost_micros
  from
    ${helpers.googleAdsSourceTable(source, 'KeywordStats')}
  group by
    date,
    campaign_id,
    ad_group_id,
    keyword_id
),

-- The search terms Google chose to disclose. Covers a subset of the spine above.
search_terms as (
  select
    segments_date as date,
    campaign_id,
    ad_group_id,
    -- criterion id out of the resource name, e.g.
    -- 'customers/123/adGroupCriteria/456~789' -> 789. Mirrors helpers.googleAdsKeywordKeyFromStats.
    cast(regexp_extract(segments_keyword_ad_group_criterion, r'adGroupCriteria/[0-9]+~([0-9]+)$') as int64) as keyword_id,
    coalesce(search_term_view_search_term, '(not set)') as search_term,
    sum(metrics_impressions) as impressions,
    sum(metrics_clicks) as clicks,
    sum(metrics_conversions) as conversions,
    sum(metrics_cost_micros) as cost_micros
  from
    ${helpers.googleAdsSourceTable(source, 'SearchQueryStats')}
  group by
    date,
    campaign_id,
    ad_group_id,
    keyword_id,
    search_term
),

-- What the disclosed terms account for, rolled back up to the spine's grain.
disclosed as (
  select
    date,
    campaign_id,
    ad_group_id,
    keyword_id,
    sum(impressions) as impressions,
    sum(clicks) as clicks,
    sum(conversions) as conversions,
    sum(cost_micros) as cost_micros
  from
    search_terms
  group by
    date,
    campaign_id,
    ad_group_id,
    keyword_id
),

-- The remainder: activity on terms Google withheld. Keeping it as its own row is what
-- lets the report total to the same numbers as the Google Ads UI.
withheld as (
  select
    k.date,
    k.campaign_id,
    k.ad_group_id,
    k.keyword_id,
    '(not disclosed)' as search_term,
    k.impressions - coalesce(d.impressions, 0) as impressions,
    k.clicks - coalesce(d.clicks, 0) as clicks,
    k.conversions - coalesce(d.conversions, 0) as conversions,
    k.cost_micros - coalesce(d.cost_micros, 0) as cost_micros
  from
    keyword_stats k
  left join
    disclosed d
    using (date, campaign_id, ad_group_id, keyword_id)
  where
    k.impressions - coalesce(d.impressions, 0) > 0
    or k.clicks - coalesce(d.clicks, 0) > 0
    or k.conversions - coalesce(d.conversions, 0) > 0
    or k.cost_micros - coalesce(d.cost_micros, 0) > 0
),

combined as (
  select * from search_terms
  union all
  select * from withheld
),

-- Dimension views hold one snapshot per day; the latest one is the current state.
campaigns as (
  select
    campaign_id,
    any_value(campaign_name) as campaign_name
  from
    ${helpers.googleAdsSourceTable(source, 'Campaign')}
  where
    ${helpers.googleAdsLatestSnapshotFilter}
  group by
    campaign_id
),

ad_groups as (
  select
    ad_group_id,
    any_value(ad_group_name) as ad_group_name
  from
    ${helpers.googleAdsSourceTable(source, 'AdGroup')}
  where
    ${helpers.googleAdsLatestSnapshotFilter}
  group by
    ad_group_id
),

keywords as (
  select
    ad_group_id,
    ad_group_criterion_criterion_id as keyword_id,
    any_value(ad_group_criterion_keyword_text) as keyword,
    any_value(ad_group_criterion_keyword_match_type) as keyword_match_type
  from
    ${helpers.googleAdsSourceTable(source, 'Keyword')}
  where
    ${helpers.googleAdsLatestSnapshotFilter}
  group by
    ad_group_id,
    keyword_id
),

-- Account currency, the unit for the cost column. One row.
customer as (
  select
    any_value(customer_currency_code) as currency
  from
    ${helpers.googleAdsSourceTable(source, 'Customer')}
  where
    ${helpers.googleAdsLatestSnapshotFilter}
)

select
  combined.date,

  -- entities, from the latest dimension snapshots
  combined.campaign_id,
  campaigns.campaign_name,
  combined.ad_group_id,
  ad_groups.ad_group_name,
  combined.keyword_id,
  -- keywords removed from the account since the click keep their metrics but lose their name
  coalesce(keywords.keyword, '(not set)') as keyword,
  coalesce(keywords.keyword_match_type, '(not set)') as keyword_match_type,
  combined.search_term,

  customer.currency,

  -- metrics, summed across device / ad network to the grain above
  combined.impressions,
  combined.clicks,
  safe_divide(combined.clicks, combined.impressions) as ctr,
  -- fractional; Google Ads attributes conversions fractionally
  combined.conversions,
  safe_divide(combined.conversions, combined.clicks) as conversion_rate,
  -- cost is stored in millionths of the account currency
  combined.cost_micros / 1000000 as cost,

  ${helpers.googleAdsDataIsFinal('combined.date', dayThreshold)} as data_is_final,
  current_datetime() as row_inserted_timestamp
from
  combined
left join
  campaigns
  using (campaign_id)
left join
  ad_groups
  using (ad_group_id)
left join
  keywords
  using (ad_group_id, keyword_id)
cross join
  customer
